@page "/"
@layout LoginLayout
@inject HttpClient httpClient
@using BlazorLogin.Client.Extensiones
@using BlazorLogin.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider autenticacionProvider
@inject NavigationManager navManager

<div class="row mt-5">
    <div class="col-1g-4 offset-1g-4 border">
        <div class="mb-3 text-center">
            <h3>Inicio de Sesión</h3>
        </div>      
        <div class="mb-3">
            <label>Correo</label>
            <input @bind="login.Correo" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Contraseña</label>
            <input @bind="login.Clave" class="form-control" />
        </div>
        <div class="mb-3">
            <button @onclick="IniciarSesion" class="btn btn-primary">Login</button>
        </div>
    </div>

</div>
@if (!string.IsNullOrEmpty(MensajeError))
{
    <div class="alert alert-danger">@MensajeError</div>
}
@code {
    private LoginDTO login = new LoginDTO();
    private string MensajeError { get; set; } = string.Empty;
    private async Task IniciarSesion()
    {
        try
        {
            var response = await httpClient.PostAsJsonAsync("/api/Usuario/Login", login);

            if (response.IsSuccessStatusCode)
            {
                // ¡Cambio clave aquí! Usa ReadFromJsonAsync<SesionDTO> directamente
                var sesionUsuario = await response.Content.ReadFromJsonAsync<SesionDTO>();

                if (sesionUsuario != null) // Validación adicional
                {
                    var autenticationExt = (AutenticationExtension)autenticacionProvider;
                    await autenticationExt.ActualizarEstadoAutenticacion(sesionUsuario);
                    navManager.NavigateTo("/Index", forceLoad: true); // Fuerza recarga
                }
            }
            else
            {
                MensajeError = "Usuario y/o contraseña incorrectas";
            }
        }
        catch (Exception ex)
        {
            MensajeError = "Error de conexión";
            Console.WriteLine(ex.ToString()); // Depuración
        }
    }
}
