@page "/"
@layout LoginLayout
@inject HttpClient httpClient
@using BlazorLogin.Client.Extensiones
@using BlazorLogin.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider autenticacionProvider
@inject NavigationManager navManager

<div class="row mt-5">
    <div class="col-1g-4 offset-1g-4 border">
        <div class="mb-3 text-center">
            <h3>Inicio de Sesión</h3>
        </div>
        <div class="mb-3">
            <label>Correo</label>
            <input @bind="login.Correo" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Contraseña</label>
            <input @bind="login.Clave" class="form-control" />
        </div>
        <div class="mb-3">
            <button @onclick="IniciarSesion" class="btn btn-primary">Login</button>
        </div>
    </div>

</div>
@code {
    private LoginDTO login = new LoginDTO();
    private string MensajeError { get; set; } = string.Empty;
    private async Task IniciarSesion()
    {
    try
    {
                var response = await httpClient.PostAsJsonAsync("/api/Usuario/Login", login);
                var content = await response.Content.ReadFromJsonAsync<ResponseDTO<SesionDTO>>();

                if (response.IsSuccessStatusCode && content?.Value != null)
                {
                    var autenticationExt = (AutenticationExtension)autenticacionProvider;
                    await autenticationExt.ActualizarEstadoAutenticacion(content.Value);
                    navManager.NavigateTo("/");
                }
                else
                {
                    // Mostrar mensaje de error
                    MensajeError = content?.Message ?? "Credenciales inválidas";
                    // Limpiar sesión
                    var autenticationExt = (AutenticationExtension)autenticacionProvider;
                    await autenticationExt.ActualizarEstadoAutenticacion(null);
                }
            }
            catch (Exception ex)
            {
                MensajeError = "Error de conexión";
            }
        }
    }
}
