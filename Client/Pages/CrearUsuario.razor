@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager
@page "/crear-usuario"

<h3>Crear Nuevo Usuario</h3>

<EditForm Model="@usuarioModel" OnValidSubmit="@HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="email">Correo electrónico:</label>
        <InputText id="email" @bind-Value="usuarioModel.Email" class="form-control" />
    </div>

    <div class="form-group">
        <label for="password">Contraseña:</label>
        <InputText id="password" type="password" @bind-Value="usuarioModel.Password" class="form-control" />
    </div>

    <div class="form-group">
        <label for="rol">Rol:</label>
        <InputSelect id="rol" @bind-Value="usuarioModel.Rol" class="form-control">
            <option value="">Seleccione un rol...</option>
            <option value="Admin">Admin</option>
            <option value="Usuario">Usuario</option>
        </InputSelect>
    </div>

    <div class="form-group mt-4">
        <button type="button" class="btn btn-secondary mr-2" @onclick="Cancelar">Cancelar</button>
        <button type="submit" class="btn btn-primary">Crear Usuario</button>
    </div>
</EditForm>

@code {
    private UsuarioModel usuarioModel = new UsuarioModel();

    private void HandleSubmit()
    {
        // Lógica para crear el usuario
        Console.WriteLine($"Usuario creado: {usuarioModel.Email}, Rol: {usuarioModel.Rol}");
        // Aquí iría tu lógica para guardar el usuario
    }

    private void Cancelar()
    {
        // Regresa a la página anterior o al login
        NavigationManager.NavigateTo("/login");
    }

    public class UsuarioModel
    {
        [Required(ErrorMessage = "El correo es requerido")]
        [EmailAddress(ErrorMessage = "Debe ser un correo válido")]
        public string Email { get; set; }

        [Required(ErrorMessage = "La contraseña es requerida")]
        [MinLength(6, ErrorMessage = "La contraseña debe tener al menos 6 caracteres")]
        public string Password { get; set; }

        [Required(ErrorMessage = "Debe seleccionar un rol")]
        public string Rol { get; set; }
    }

    [Inject]
    protected NavigationManager NavigationManager { get; set; }
}